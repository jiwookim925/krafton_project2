# backend/.env.example
# 복사해서 backend/.env 로 저장 후 값을 채우세요. (.env는 git에 올라가지 않습니다)
# 이 파일은 FastAPI(로그인 백엔드)용 환경변수입니다.

# --- 카카오 로그인 ---
# 카카오 개발자 콘솔(https://developers.kakao.com) → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_REST_API_KEY=your-kakao-rest-api-key
# 카카오 콘솔의 Redirect URI에도 아래와 똑같이 등록해야 함
KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback
# 카카오 로그인 → 보안 → Client Secret 을 "사용함"으로 켰다면 그 코드값을 넣기. 껐으면 비워두기
KAKAO_CLIENT_SECRET=

# --- JWT ---
# FastAPI가 발급하고 Django가 검증하므로 backend/tistory-backend/.env 의 JWT_SECRET_KEY와 반드시 동일해야 함.
# 아무 랜덤 문자열로 바꾸세요.
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- DB ---
# docker-compose의 db 서비스 기본값과 일치 (컨테이너 내부에서는 host가 db)
DATABASE_URL=postgresql://dev:devpass@db:5432/tistory_clone

# 로그인 성공 후 돌려보낼 프론트 주소
FRONTEND_REDIRECT_URL=http://localhost:3000
